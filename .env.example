# Obrigatórias para a aplicação e para as migrations Prisma.
DATABASE_URL="postgresql://usuario:senha@host:5432/otica_dumas?schema=public"
AUTH_SECRET="gere-um-segredo-longo-e-aleatorio"

# Configuração pública do site.
NEXT_PUBLIC_WHATSAPP_NUMBER="5514999999999"
NEXT_PUBLIC_SITE_URL=""

# Obrigatórias para upload e remoção de imagens no Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Usadas somente ao executar o seed manualmente; não são necessárias para o start.
ADMIN_NAME="Administrador Ótica Dumas"
ADMIN_EMAIL="admin@example.invalid"
ADMIN_PASSWORD="defina-uma-senha-forte"

# Opcionais: usados pelo docker-compose local.
POSTGRES_DB="otica_dumas"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
PORT="3000"
